store-assets/raw/

# Signing material — NEVER commit a certificate or private key
*.pfx
*.p12
*.key
*.cer
devcert*

# Logs & env
*.log
.env
.env.*
!.env.example

# Personal / private notes (never commit — this repo is public)
future-steps.md
# Store submission notes: listing copy, Partner Center identity, packaging runbook.
STORE-NOTES.md
# Generated Store artwork + composed listing screenshots (regenerate with scripts/store-assets.py).
store-assets/

